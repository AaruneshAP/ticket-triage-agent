# ==============================================================================
# Ticket Triage Agent Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or print secret values.
# ==============================================================================

# GitHub Ingestion (Read-only for home-assistant/core)
GITHUB_TOKEN=

# GitHub Sandbox Repository (Phase 10: Bot triage demo)
SANDBOX_REPO=
GITHUB_SANDBOX_TOKEN=

# Databricks Lakehouse (Serverless SQL Warehouse)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
DATABRICKS_CATALOG=
DATABRICKS_RAW_SCHEMA=

# LLM Providers (LangGraph Agent: Groq primary, Google Gemini fallback)
GROQ_API_KEY=
GEMINI_API_KEY=

# Langfuse Observability & Tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Google Sheets Bridge (Looker Studio Monitoring)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Telegram / Alert Router (n8n Webhook / Bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hugging Face Space Demo
HF_TOKEN=
HF_USERNAME=

# Local Service Configuration
TRIAGE_API_URL=
API_HOST=
API_PORT=
STREAMLIT_PORT=
MLFLOW_TRACKING_URI=
